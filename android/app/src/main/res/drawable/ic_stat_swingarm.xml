<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon: the swingarm mark from assets/app/icon-only.svg
     (wheel, arm, pivot and axle block), as one white shape, since Android
     draws status bar icons in a single color. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <group
        android:scaleX="0.94"
        android:scaleY="0.94"
        android:translateX="2.77"
        android:translateY="-6.4">
        <!-- Wheel -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9"
            android:pathData="M38,60a26,26 0,1 0,52 0a26,26 0,1 0,-52 0" />
        <!-- Arm -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M15.83,38.29L65.37,55.72L62.63,64.28L12.17,49.71Z" />
        <!-- Pivot, with its bolt hole -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M6,44a8,8 0,1 0,16 0a8,8 0,1 0,-16 0ZM11,44a3,3 0,1 0,6 0a3,3 0,1 0,-6 0Z" />
        <!-- Axle block, with the axle -->
        <group
            android:pivotX="64"
            android:pivotY="60"
            android:rotation="17.7">
            <path
                android:fillColor="#FFFFFFFF"
                android:fillType="evenOdd"
                android:pathData="M57,55h14v10h-14ZM60.8,60a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0Z" />
        </group>
    </group>
</vector>
