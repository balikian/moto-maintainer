<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications. Xcode switches it to production for TestFlight and App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- swingarm.app links that open the app (universal links): iOS checks
	     swingarm.app/.well-known/apple-app-site-association, which lists the
	     store app only, like Android's App Links. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:swingarm.app</string>
	</array>
</dict>
</plist>
